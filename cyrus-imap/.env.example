# Copy to .env if you want to override this. LDAP and Cyrus config now live
# directly in config/imapd.conf and config/saslauthd.conf - see their
# .example counterparts and the README.

# CN used in the auto-generated self-signed TLS cert (ignored if you mount your own)
TLS_CN=localhost

# Planned parametrization candidates for imapd.conf (not wired up yet - see
# docs/ for the substitution mechanism proposal; these are just named here
# for reference).
SERVERNAME=cyrus-imap
LOGINREALMS=home.lan
DEFAULTDOMAIN=home.lan
ADMINS=admin
AUTOCREATE_QUOTA=512000
